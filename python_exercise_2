from abc import ABC, abstractmethod

class Payable(ABC):

    @abstractmethod
    def process_payment(self, amount: float):
        pass
    @abstractmethod
    def get_payment_status(self) -> str:
        pass

class PaymentMethod(Payable, ABC):

    total_transactions = 0

    def __init__(self, account_holder: str, balance: float):
        self.account_holder = account_holder
        self.balance = balance

    @abstractmethod
    def validate_account(self):
        pass

    def get_payment_status(self) -> str:
        return f"{self.account_holder} has a remaining balance of ${self.balance:.2f}"

    @classmethod
    def get_total_transactions(cls):
        return cls.total_transactions

class CreditCard(PaymentMethod):

    def __init__(self, account_holder: str, balance: float, credit_limit: float):
        super().__init__(account_holder, balance)
        self.credit_limit = credit_limit

    def validate_account(self):
        if self.balance < -self.credit_limit:
            print("Account over credit limit.")

    def process_payment(self, amount: float):
        if amount > self.balance + self.credit_limit:
            print("Transaction Declined.")
            return

        self.balance -= amount
        PaymentMethod.total_transactions += 1
        print(f"CreditCard Payment Processed: ${amount}")


class MealPlan(PaymentMethod):

    def validate_account(self):
        if self.balance < 0:
            print("Invalid Meal Plan: Negative balance not allowed.")

    def process_payment(self, amount: float):
        if amount > self.balance:
            print("Meal Plan Declined: Insufficient balance.")
            return

        self.balance -= amount
        PaymentMethod.total_transactions += 1
        print(f"MealPlan Payment Processed: ${amount}")

if __name__ == "__main__":
    payment_queue = []

    #One CreditCard and one MealPlan
    payment_queue.append(CreditCard("Marcus", 200.0, 300.0))
    payment_queue.append(MealPlan("Alice", 120.0))

    for p in payment_queue:
        p.process_payment(50.0)
        print(p.get_payment_status())

    # Print total transactions
    print("\nTotal Transactions:", PaymentMethod.get_total_transactions())
